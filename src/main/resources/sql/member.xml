<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.devstudy.mapper.MemberMapper">

    <select id="memberCnt" resultType="int">
        SELECT COUNT(*)
        FROM members
    </select>
    
     <insert id="insertMember" parameterType="com.devstudy.vo.MemberVO" useGeneratedKeys="true" keyProperty="memberIdx" keyColumn="member_id">
        INSERT INTO members(email,password_hash,nickname) 
        VALUES (#{email}, #{password}, #{nickname})
    </insert>
    
    <resultMap id="memberResultMap"
           type="com.devstudy.vo.MemberVO">
	    <id column="member_id" property="memberIdx"/>
	    <result column="email" property="email"/>
	    <result column="password_hash" property="password"/>
	    <result column="nickname" property="nickname"/>
	    <result column="role" property="role"/>
	    <result column="status" property="status"/>
	    <result column="created_at" property="createdAt"/>
	    <result column="updated_at" property="updatedAt"/>
	</resultMap>
	
	<select id="selectMemberByEmail"
	        parameterType="com.devstudy.vo.MemberVO"
	        resultMap="memberResultMap">
	    SELECT member_id,
	           email,
	           password_hash,
	           nickname,
	           role,
	           status,
	           created_at,
	           updated_at
	    FROM members
	    WHERE email = #{email}
	</select>

</mapper>